# Copy to .env (make setup does this). Never commit .env.
# Provider: Google Gemini (LLM, embeddings). AWS Bedrock stays available: see the bottom section.

# --- Gemini credentials (one of the two) ---
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ...or Vertex AI: leave GEMINI_API_KEY empty, set the project, run `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- LLMs (`make models` lists what your key can use) ---
LLM_BACKEND=gemini
# flash = extraction (many calls); pro = judge, reviewer, answers (fewer calls, stronger).
# Tested 2026-11-15 (paid key): 3.6-flash extracts, 3.8-flash judges ($0.75 / $3.75 per 1M each; both double
# on 2027-01-01). gemini-4-hydrogen ($1.50 / $7.50) is the next step up. Cheaper: gemini-3.1-flash-lite.
GEMINI_MODEL_FLASH=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.8-flash
# minimal | low | medium | high, or empty = model default (how much the model thinks; low keeps cost down)
GEMINI_THINKING=low
# Requests per minute across all parallel calls (0 = no limit). Free tier: ~10. 429s are retried anyway,
# honouring Google's retryDelay; a DAILY quota stops the check with a clear error.
GEMINI_RPM=0

# --- Embeddings: gemini | bedrock | hash (hash = offline word hashing, tests / dev only) ---
EMBED_BACKEND=gemini
EMBED_MODEL=gemini-embedding-001
# 768 | 1536 | 3072. Changing model or dimension = delete data/qdrant and re-ingest.
EMBED_DIM=1536

# --- Reranking: none | llm (Gemini flash) | bedrock ---
RERANK_BACKEND=none

# --- Check workflow (defaults are fine) ---
# CONCURRENCY=8
# TOP_K=6
# EXTRACT_TIER=flash
# JUDGE_TIER=pro
# REVIEW_TIER=pro

# --- Storage ---
# empty = embedded Qdrant in data/qdrant; docker compose sets http://qdrant:6333
QDRANT_URL=
# DATA_DIR=./data
# TRACE_DIR=./traces

# --- Optional: AWS Bedrock instead of Gemini (LLM_BACKEND=bedrock, EMBED_BACKEND=bedrock) ---
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL_FLASH=qwen.qwen3-235b-a22b-2507
BEDROCK_MODEL_PRO=qwen.qwen3-235b-a22b-2507
BEDROCK_EFFORT=low
# EMBED_MODEL=cohere.embed-multilingual-v3   (and EMBED_DIM=1024)
# RERANK_MODEL=cohere.rerank-v3-5:0
# RERANK_REGION=us-west-2

# --- Docker compose (docker-compose.yml) ---
# Password of the bundled Postgres. Set your own before `docker compose up`.
POSTGRES_PASSWORD=
# API defaults: per-check budget cap (USD) and the most a user may request; per-question cap
# CHECK_BUDGET_USD=1.00
# MAX_CHECK_BUDGET_USD=5.00
# ASK_BUDGET_USD=0.02
# DATABASE_URL=   (empty = SQLite in data/app.db; compose sets Postgres)
